# Remote PostgreSQL: use a dedicated database/schema and a least-privilege user.
# URL-encode reserved characters in the password. verify-full needs a trusted CA.
POSTGRES_DSN=postgresql://rag_user:CHANGE_ME@postgres.example.com:5432/rag?sslmode=verify-full

# Remote OpenSearch 2.19+ or 3.x with the k-NN plugin and Lucene engine.
# This client supports basic auth or an authenticating proxy, not AWS SigV4.
OPENSEARCH_URL=https://search.example.com:9200
OPENSEARCH_USERNAME=rag_user
OPENSEARCH_PASSWORD=CHANGE_ME
OPENSEARCH_INDEX=rag-lab-v1
# Optional private CA PEM path; TLS verification stays enabled.
# OPENSEARCH_CA_CERT=C:/certificates/opensearch-ca.pem

# Local Ollama; pull these two models before initializing the project.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CONTEXT_TOKENS=8192
EMBEDDING_DIMENSIONS=768
# Nomic retrieval prefixes. Change these for other models according to their model card.
EMBED_DOCUMENT_PREFIX="search_document: "
EMBED_QUERY_PREFIX="search_query: "

# Character-based windows, NOT token counts. Keep below the embedding context limit.
CHUNK_SIZE=1400
CHUNK_OVERLAP=200
EMBED_BATCH_SIZE=16
RETRIEVAL_CANDIDATES=30
MAX_CONTEXT_CHARS=12000
REQUEST_TIMEOUT_SECONDS=180

# Optional hosted Langfuse tracing. Use your project's region/base URL and API keys.
# SDK v5 supports Langfuse Cloud or an existing Langfuse server >=4.59.0.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
# Set true to send question text, prompts, retrieved excerpts, and answers to Langfuse.
# false still exports timings, models, token counts, result counts, and sanitized errors.
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_TIMEOUT_SECONDS=5
